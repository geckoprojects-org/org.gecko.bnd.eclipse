-plugin.bnd-Eclipse:\
	aQute.bnd.repository.p2.provider.P2Repository;\
		name="Eclipse 4.41 (2026-09)";\
		url="https://download.eclipse.org/eclipse/updates/4.41/R-4.41-202608281142/"

-plugin.bnd.eclipse.central: \
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		snapshotUrl=https://central.sonatype.com/repository/maven-snapshots/; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/bnd-eclipse-central.maven; \
		readOnly=true; \
		poll.time=-1;\
		name="Bnd Eclipse Central"
