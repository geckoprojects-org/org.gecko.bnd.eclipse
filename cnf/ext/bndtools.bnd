bndbaseversion: 7.4.0

# Always build against the released bnd, independent of snapshot or release builds
bndversion: ${bndbaseversion}

-plugin.bnd: \
	aQute.bnd.repository.maven.provider.MavenBndRepository;\
		releaseUrl=https://repo.maven.apache.org/maven2/;\
		index=${.}/bndtools.maven;\
		readOnly=true;\
		poll.time=-1;\
		name='BND Tools'
