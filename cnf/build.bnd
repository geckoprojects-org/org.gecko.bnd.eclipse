# Eclipse Fennec bnd libraries: 'fennec' brings the manifest defaults, the version handling
# (DO_RELEASE) and the Maven Central signing (releng/central.bnd, active with GPG_PASSPHRASE);
# 'fennecTest' the test repository. Where a release goes is set in cnf/ext/release.bnd.
-library: \
	fennec,\
	fennecTest

javac.source: 21
javac.target: 21

# Configure Repositories
-plugin.6.Central: \
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/central.maven; \
		readOnly=true; \
		poll.time=-1;\
		name="Maven Central"
-plugin.7.Local: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Local; \
		pretty = true; \
		local = ${build}/local

# Project coordinates
github-orga:    geckoprojects-org
github-project: org.gecko.bnd.eclipse
-groupid:       org.geckoprojects.bnd.eclipse

# The fennec library is made for Eclipse projects; this one is a Data In Motion project.
Bundle-Vendor: Data In Motion Consulting GmbH
# SPDX id plus link: bnd writes the link as the license <url> of the pom, which Maven Central checks.
Bundle-License: EPL-2.0;description="Eclipse Public License 2.0";link="https://www.eclipse.org/legal/epl-2.0/"
