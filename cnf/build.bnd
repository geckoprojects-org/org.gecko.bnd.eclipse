-library: \
	geckoDIMC,\
	fennecTest

javac.source: 21
javac.target: 21

# Configure Repositories
-plugin.6.Central: \
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/central.maven; \
		readOnly=true; \
		poll.time=-1;\
		name="Maven Central"
-plugin.7.Local: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Local; \
		pretty = true; \
		local = ${build}/local

dimcBaselining: false
github-project: org.gecko.bnd.eclipse
-groupid: org.geckoprojects.bnd.eclipse

# Nexus login from the environment (Jenkins credential dim-nexus); local files still apply.
-connection-settings: \
	-bnd,\
	-maven,\
	server; \
		id=devel.data-in-motion.biz; \
		username="${env;NEXUS_USERNAME;}"; \
		password="${env;NEXUS_PASSWORD;}"
